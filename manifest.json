{
  "manifest_version": 3,
  "name": "Blinkit Bulk Invoice Zipper",
  "version": "1.5.0",
  "description": "Bulk-downloads your own Blinkit order invoices into a single ZIP, using your logged-in session.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "https://*.blinkit.com/*",
    "https://*.amazonaws.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.blinkit.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.blinkit.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Blinkit Invoice Zipper"
  },
  "background": {
    "service_worker": "background.js"
  }
}